# Neon Lakebase Postgres (pooled connection for app traffic)
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Neon Auth (Managed Better Auth)
NEON_AUTH_BASE_URL=https://your-project.neonauth.region.aws.neon.tech/neondb/auth
NEON_AUTH_COOKIE_SECRET=generate-a-32-char-secret

# Neon AI Gateway (server-side only)
NEON_AI_GATEWAY_URL=
NEON_AI_GATEWAY_API_KEY=

# Email (Resend, SendGrid, or SMTP — required before outbox dispatch)
EMAIL_PROVIDER=
EMAIL_FROM=
EMAIL_API_KEY=

# Payments (Stripe or other — required before paid introduction checkout)
PAYMENT_GATEWAY=
PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=

# PEP screening vendor (required before PEP runs)
PEP_VENDOR=
PEP_API_KEY=

# Voice provider (required before voice intake)
VOICE_PROVIDER=
VOICE_API_KEY=

# Malware scanner (required before document extraction)
MALWARE_SCANNER=
MALWARE_SCANNER_API_KEY=

# Public app URL (referral links, emails, Stripe return URLs). On Vercel + Neon, set this in the
# Vercel project environment for production/preview — not in Neon Postgres settings.
# Local dev:
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Production (FinSyndeo on Vercel):
# NEXT_PUBLIC_APP_URL=https://finsyndeo.vercel.app
